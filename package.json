{
  "name": "thai-retail-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Thai retail point-of-sale desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "th.demo.retailpos",
    "productName": "Thai Retail POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "setup.html",
      "style.css",
      "app.js",
      "server.js",
      "main.js",
      "preload.js",
      "manifest.webmanifest",
      "icon.svg",
      "service-worker.js",
      "js/**/*",
      "!data/**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ร้านค้าปลีก POS"
    }
  },
  "allowScripts": {
    "electron@36.9.5": true
  }
}

